# Chép thành .env ở thư mục gốc (cạnh docker-compose.yml) rồi điền giá trị thật.
# KHÔNG commit file .env. Trên máy chủ file nằm ở /opt/tigernet/.env, quyền 600.

# ---- Image (CI tự cập nhật IMAGE_TAG khi deploy) ----
# Local: REGISTRY=tigernet, IMAGE_TAG=local (build tại chỗ). Máy chủ: ghcr.io/<owner viết thường>
REGISTRY=ghcr.io/nhatpham12
IMAGE_TAG=dev

# ---- Tên miền + Let's Encrypt ----
# Local: để localhost (chạy HTTP). Máy chủ: tên miền đã trỏ bản ghi A về IP public
DOMAIN=localhost
LETSENCRYPT_EMAIL=
# 1 = dùng máy chủ thử (staging) của Let's Encrypt khi đang thử, tránh bị giới hạn số lần cấp
LETSENCRYPT_STAGING=0
# Token đăng nhập nằm trong cookie Secure. Trình duyệt chỉ nhận cookie Secure qua HTTPS hoặc localhost.
# Chỉ đặt false khi tạm truy cập bằng HTTP thuần qua tên miền/IP (chưa có chứng chỉ); có HTTPS thì để true.
BFF_COOKIE_SECURE=true

# ---- Database ----
DB_NAME=tigernet_dev
DB_USERNAME=tigernet
DB_PASSWORD=doi-mat-khau-nay
MYSQL_ROOT_PASSWORD=doi-mat-khau-root-nay

# ---- Backend ----
# HS512: tối thiểu 64 ký tự. Sinh bằng: openssl rand -base64 64 | tr -d '\n'
JWT_SIGNER_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
# Mã hoá khoá xác thực 2 bước (TOTP) của Quản trị. Sinh bằng: openssl rand -base64 32
# Để trống = TẮT xác thực 2 bước. Đổi khoá thì mọi Quản trị phải cài lại MFA.
MFA_ENC_KEY=

# ---- Tài khoản demo (deploy/scripts/seed-demo-users.sh) ----
DEMO_PASSWORD=

# ---- Sao lưu (deploy/scripts/backup-db.sh) ----
BACKUP_KEEP_DAYS=14
# Để trống nếu chỉ lưu trên ổ máy chủ. Có giá trị thì đẩy thêm lên S3 (cần AWS CLI và quyền ghi bucket)
BACKUP_S3_BUCKET=
